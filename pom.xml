<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fss</groupId>
    <artifactId>flash-sale-system</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>flash-sale-system</name>
    <description>高并发秒杀系统</description>

    <modules>
        <module>fss-common</module>
        <module>fss-infra</module>
        <module>fss-domain</module>
        <module>fss-biz</module>
        <module>fss-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.3.5</spring-boot.version>
        <!-- 与 spring-boot-dependencies 3.3.5 保持一致；BOM 的 property 不会被继承，需显式声明 -->
        <lombok.version>1.18.34</lombok.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
        <testcontainers.version>1.20.3</testcontainers.version>
        <redisson.version>3.36.0</redisson.version>
        <sentinel.version>1.8.8</sentinel.version>
        <rocketmq-spring.version>2.3.1</rocketmq-spring.version>

        <!--
            surefire 与 failsafe 必须同版本：两者共用同一个 JUnit Platform provider，
            版本错开时会出现"单测正常、集成测试找不到引擎"这类只在一侧复现的问题。
            本项目没有用 spring-boot-starter-parent（只 import 了 BOM），插件版本
            不受任何管理，不显式声明就取 Maven 超级 POM 的默认值——换一台 Maven
            版本不同的机器，跑的就是另一个 surefire。
        -->
        <maven-surefire.version>3.5.2</maven-surefire.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
                MyBatis-Plus 3.5.9 起把 JSqlParser 从核心包里剥离了，
                PaginationInnerInterceptor 依赖它，必须显式引入，否则编译期找不到类。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!--
                Redisson 用<b>裸包</b>而不是 redisson-spring-boot-starter：
                starter 会把 Spring Boot 自动装配的 Lettuce RedisConnectionFactory 换成
                Redisson 自己的实现，于是 StringRedisTemplate 也走 Redisson。
                本项目的分工是「Lua 与普通读写走 Lettuce，分布式锁走 Redisson」——
                两套客户端各用其长，且 starter 的版本与 Spring Boot / Spring Data Redis
                强耦合，升级 Boot 小版本就可能装配失败。裸包 + 一个手写的
                RedissonClient @Bean 只有 20 行，换来的是完全可控的装配。
            -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!--
                Sentinel 同理只引注解切面（它会传递引入 sentinel-core），
                不引 spring-cloud-starter-alibaba-sentinel —— 那个 starter 绑定
                Spring Cloud 版本，而本项目是模块化单体，没有 Spring Cloud。
            -->
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-annotation-aspectj</artifactId>
                <version>${sentinel.version}</version>
            </dependency>

            <!--
                rocketmq-spring-boot-starter 2.3.1 是<b>针对 Spring Boot 2.7 编译</b>的
                （其 parent 声明 spring.boot.version=2.7.18、java.version=1.8）。
                在 Boot 3.3 上能用，靠的是两件事，缺一件都不行：
                  1. 它把 spring-boot / spring-boot-autoconfigure 声明为 optional，
                     实际版本由本项目的 BOM 决定，不会把 2.7 拖进来；
                  2. 它已经提供 META-INF/spring/*.AutoConfiguration.imports
                     （Boot 2.7 引入、Boot 3 唯一认的自动装配清单）。
                并且它整个包不碰 javax.servlet / javax.annotation —— 只做生产者与
                消费者的生命周期管理，没有 jakarta 迁移的表面。
                我们仍然显式排除它传递进来的 jackson，避免它 2.11 的版本压过 BOM 里的。
            -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-databind</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>com.fss</groupId>
                <artifactId>fss-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fss</groupId>
                <artifactId>fss-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fss</groupId>
                <artifactId>fss-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fss</groupId>
                <artifactId>fss-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 钉住当前实际解析到的版本。不写时取 Maven 超级 POM 的默认值，
                     换一台 Maven 版本不同的机器编译器就换了，而 Maven 自己会为此
                     报一条 "threaten the stability of your build" 的警告 -->
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                ============================ 测试分层 ============================
                测试分两类，跑法完全不同：

                  · 快测（5 个类）纯 JUnit，不起 Spring、不碰 Docker，毫秒级
                  · 集成测试（18 个类）继承 IntegrationTestBase，要起 MySQL +
                    Redis + RocketMQ 三套 Testcontainers，约 6 分钟

                分开的理由不是洁癖：合在一起时唯一能跑的命令是"全跑"，而全跑需要
                Docker，于是日常构建只能写 -DskipTests——等于没有快速反馈回路。

                筛选靠 IntegrationTestBase 上的 @Tag("integration")。@Tag 是
                @Inherited 的，18 个子类自动继承，不需要逐个标注；新增的集成测试
                只要继承基类就自动落到正确的一边，不会因为忘了打标签而漏跑。

                  mvn test              → 只跑快测，不需要 Docker
                  mvn verify -DskipITs  → 快测 + 打包，不需要 Docker
                  mvn verify            → 全部，需要 Docker
                =================================================================
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire.version}</version>
                <configuration>
                    <!--
                        @{argLine} 是 JaCoCo prepare-agent 注入 agent 参数的位置，
                        必须用 @{} 的延迟求值而不是 ${}：${} 在插件配置解析时就取值，
                        那时 prepare-agent 还没执行，拿到的是空。

                        -Dfile.encoding=UTF-8 不能去掉：EvalShaScriptExecutorTest
                        的 FakeRedis 依赖"测试 JVM 是 UTF-8、被模拟的运行时是 GBK"
                        这个差异来复现 EVALSHA 回落缺陷，去掉之后那个用例退化成
                        恒等变换，永远绿灯。
                    -->
                    <argLine>@{argLine} -Dfile.encoding=UTF-8</argLine>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-surefire.version}</version>
                <configuration>
                    <argLine>@{failsafeArgLine} -Dfile.encoding=UTF-8</argLine>
                    <groups>integration</groups>
                    <!--
                        仓库里没有 *IT 命名的类，failsafe 默认的 includes
                        （**/IT*.java、**/*IT.java、**/*ITCase.java）一个也匹配不上，
                        表现是"集成测试一个没跑，构建还是绿的"。改成与 surefire 同样的
                        命名规则，真正的筛选交给上面的 groups。
                    -->
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <!--
                        必须显式指定。spring-boot-maven-plugin 的 repackage 在
                        package 阶段把主 artifact 换成了 fat jar，而 failsafe 默认
                        拿主 artifact 当测试 classpath——fat jar 里的类在
                        BOOT-INF/classes 下，普通 classloader 找不到，
                        症状是 ClassNotFoundException 而不是"配置错了"。
                    -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <!-- verify 这个 goal 负责把失败结果抛出来；只配
                                 integration-test 的话测试跑了但失败不会让构建红 -->
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                覆盖率。只出报告、不设阈值门禁——先拿到基线数字，而不是让一个
                拍脑袋的阈值把 CI 搞红。

                单测与集成测试分别记到两个 exec 文件再合并：集成测试覆盖的是
                Lua、消费端、对账这些主路径，单测覆盖的是状态机与导出格式，
                两边差别很大，只统计其中一边得出的结论会误导。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>argLine</propertyName>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <!--
                                propertyName 必须显式给。prepare-agent-integration
                                的默认值<b>也是 argLine</b>（不是想当然的 failsafeArgLine），
                                不指定的话两件事同时发生：它在 pre-integration-test
                                阶段把 argLine 覆盖成指向 jacoco-it.exec，而 failsafe
                                配置里的 @{failsafeArgLine} 因为属性不存在<b>原样</b>
                                传给了 java 命令行。症状是
                                "The forked VM terminated without properly saying goodbye"，
                                看起来像 JVM 崩溃，实际是命令行里多了个字面量 @{...}。
                            -->
                            <propertyName>failsafeArgLine</propertyName>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                        </configuration>
                    </execution>
                    <!-- merge 必须声明在 report 之前：同一阶段内的执行顺序按声明顺序 -->
                    <execution>
                        <id>merge-exec</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
